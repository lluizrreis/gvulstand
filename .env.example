# GvulStand Configuration
APP_NAME="GvulStand - Vulnerability Management System"
APP_PORT=8000
# ATENÇÃO: Gere uma chave aleatória e segura para produção (ex: openssl rand -hex 32)
SECRET_KEY="substitua-por-uma-chave-secreta-forte-e-aleatoria"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin User Credentials
DEFAULT_ADMIN_USERNAME="Admin"
DEFAULT_ADMIN_PASSWORD="substitua_pela_senha_do_administrador"
DEFAULT_ADMIN_EMAIL="admin@exemplo.com"

# Database URL:
# Local Standalone (SQLite):
DATABASE_URL="sqlite:///./data/gvulstand.db"

# Docker PostgreSQL Configuration:
POSTGRES_DB=gvulstand
POSTGRES_USER=gvuluser
POSTGRES_PASSWORD=defina_uma_senha_postgres_forte_aqui
POSTGRES_PORT=5432
